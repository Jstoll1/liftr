// The week a request is about: an explicit ?week=N, else the current one.
async function weekFrom(env, url) {
  const raw = url.searchParams.get("week");
  const n = raw === null ? null : Number(raw);
  if (Number.isInteger(n) && n >= 1 && n <= 30) return n;
  return (await readWeeks(env)).current;
}

// Per-isolate cache of the assembled picks map (see GET /picks).
let picksCache = null;
// Five seconds: on the paid plan KV reads are no longer scarce, so a pick
// saved on one phone shows on the others almost at once.
const PICKS_CACHE_MS = 5000;

// Kickoff times for a week, read from that week's stored games. Week 1
// predates the games store, so its hardcoded table below is the fallback.
// The Sweatpants Amendment, carried 2026-09-24: from week 4 every pick
// locks at the week's first kickoff, so every game's lock time is the
// earliest kickoff. Before that, each game locked at its own.
let LOCK_ALL_FROM_WEEK = 4;
// The NFL lock: every game from Sunday's 1pm ET kickoff on locks at that
// kickoff, so all of Sunday, Sunday night and Monday are in by 1pm. A game
// before it (Thursday night, a London morning) locks at its own kickoff,
// since by Sunday it has been played. The app applies the same rule.
const ET_PARTS = new Intl.DateTimeFormat("en-US", { timeZone: "America/New_York", weekday: "short", hour: "numeric", hourCycle: "h23" });
