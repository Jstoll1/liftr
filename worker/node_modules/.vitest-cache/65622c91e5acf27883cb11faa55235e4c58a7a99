// One lock a week, on a pick. A lock on a game already kicked off is final
// and wins; otherwise the most recently changed locked pick keeps it. In a
// week without the lock rule every flag is dropped.
function settleLock(picks, stored, kickoffs, now, week) {
  // Locks are spread picks only (a flat +3 / -3 on a favourite to win would
  // be near free points): a lock on any other pick is dropped.
  for (const [id, p] of Object.entries(picks)) if (p?.lock && p.mode !== "ATS") { const { lock, ...rest } = p; picks[id] = rest; };
  const locked = Object.entries(picks).filter(([, p]) => p?.lock);
  if (!lockOnWeek(week)) { for (const [id] of locked) { const { lock, ...rest } = picks[id]; picks[id] = rest; }; return; };
  if (locked.length <= 1) return;
  const frozen = locked.find(([id]) => kickoffs[id] && now >= kickoffs[id] && stored[id]?.lock);
  const keep = frozen ? frozen[0] : locked.sort(([, a], [, b]) => (b.updatedAt || 0) - (a.updatedAt || 0))[0][0];
  for (const [id] of locked) if (id !== keep) { const { lock, ...rest } = picks[id]; picks[id] = rest; }
};

async function handlePicks(request, env, corsHeaders, url) {
  if (!env.LIFTR_KV) {
    console.error("LIFTR_KV binding missing");
    return json({ error: "Sync not configured" }, 500, corsHeaders);
  };

  if (request.method === "GET") {
    try {
      // Every phone polls this every 20 seconds on game day. Ten KV reads
      // per poll would burn through the free tier's daily read quota in an
      // afternoon, so the Worker keeps a short in-memory copy and serves
      // that; a save clears it so nobody waits more than a few seconds.
      const now = Date.now();
      const week = await weekFrom(env, url);
      // Before a game locks, nobody sees anyone else's pick on it. The
      // caller's own picks come back whole (?me=, proved by ?token= once
      // owner login is on); everyone else's unlocked picks come back as a
      // placeholder that still counts toward "7/10 in" but carries no team.
      // The admin key sees everything.
      const viewer = await picksViewer(env, url);
      if (picksCache && picksCache.week === week && now - picksCache.at < PICKS_CACHE_MS) {
        return json({ week, picks: maskPicks(picksCache.picks, picksCache.kickoffs, now, viewer), cached: true }, 200, corsHeaders);
      };
      const [entries, kickoffs] = await Promise.all([
        Promise.all(PICKS_MANAGERS.map(async (manager) => {
          const stored = await env.LIFTR_KV.get(pickKey(week, manager));
          return [manager, stored ? JSON.parse(stored) : null];
        })),
        kickoffsFor(env, week),
      ]);
      const picks = Object.fromEntries(entries.filter(([, value]) => value !== null));
      picksCache = { at: now, week, picks, kickoffs };
      return json({ week, picks: maskPicks(picks, kickoffs, now, viewer) }, 200, corsHeaders);
    } catch (err) {
      console.error("Picks read error", err?.stack || String(err));
      return json({ error: "Read failed" }, 500, corsHeaders);
    }
  };

  if (request.method === "POST" || request.method === "PUT") {
    let body;
    try {
      body = await request.json();
    } catch {
      return json({ error: "Invalid JSON body" }, 400, corsHeaders);
    };
    const manager = body?.manager;
    if (!PICKS_MANAGERS.includes(manager)) {
      return json({ error: "Invalid or missing manager" }, 400, corsHeaders);
    };
    // Owner login. The admin key still overrides, so a repair works even
    // for someone who has not claimed their name.
    const mode = await authMode(env);
    const owner = await tokenOwner(env, body?.token);
    const authed = owner === manager || isAdmin(env, url);
    if (mode === "on" && !authed) {
      return json({ error: `Sign in as ${manager} to save picks.`, needsLogin: true, manager }, 401, corsHeaders);
    };
