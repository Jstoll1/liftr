{
  "about": "The Chief pressure test question set. Every Chief fix adds its regression test here (regression: true, note with date and what broke); every feature members will ask about adds a test (source: feature). checks: tools (a|b = either), must / mustNot (case-insensitive regex), noAsk (no which-league reply). The app syncs new ids to the worker on the next run.",
  "tests": [
    {
      "source": "seed",
      "id": "why-low",
      "screen": "pickem",
      "turns": [
        "Why is my win % so low?"
      ],
      "checks": {
        "tools": [
          "edge"
        ],
        "mustNot": [
          "ranked \\d",
          "ceiling rank"
        ],
        "noAsk": true
      },
      "regression": true,
      "note": "Nov 21: listed bare facts, called the ceiling rank a finish"
    },
    {
      "source": "seed",
      "id": "why-other",
      "screen": "pickem",
      "turns": [
        "Why is the leader's path easier than mine?"
      ],
      "checks": {
        "tools": [
          "versus|edge"
        ],
        "noAsk": true
      },
      "regression": true,
      "note": "Nov 21: asked which league on Scores"
    },
    {
      "source": "seed",
      "id": "why-fav",
      "screen": "pickem",
      "turns": [
        "Why is the favourite the favourite this week?"
      ],
      "checks": {
        "tools": [
          "standings"
        ],
        "noAsk": true
      },
      "regression": true,
      "note": "Nov 21: named Robert (status out) the favourite; must read standings"
    },
    {
      "source": "seed",
      "id": "pushback",
      "screen": "pickem",
      "turns": [
        "Can I still win the week?",
        "That's wrong. I have a path, explain it."
      ],
      "checks": {
        "mustNot": [
          "isn'?t the top",
          "can'?t finish (first|1st)",
          "You'?re right[^.]*\\. However"
        ],
        "noAsk": true
      },
      "regression": true,
      "note": "Nov 21: agreed ('You're right') then said the opposite"
    },
    {
      "source": "seed",
      "id": "odds-cover",
      "screen": "pickem",
      "turns": [
        "What are the odds the favourite in G8 covers?"
      ],
      "checks": {
        "tools": [
          "gameOdds"
        ],
        "must": [
          "\\d+(\\.\\d+)?%"
        ],
        "mustNot": [
          "not available",
          "can.?t access"
        ]
      },
      "regression": true,
      "note": "Nov 21: gameOdds found no pick to read from; now plays the game model itself"
    },
    {
      "source": "seed",
      "id": "odds-win",
      "screen": "pickem",
      "turns": [
        "Will the G10 favourite win outright?"
      ],
      "checks": {
        "tools": [
          "gameOdds"
        ],
        "must": [
          "%"
        ],
        "mustNot": [
          "not available",
          "can.?t access"
        ]
      },
      "regression": true,
      "note": "Nov 21: same as odds-cover"
    },
    {
      "source": "seed",
      "id": "whatif-out",
      "screen": "pickem",
      "turns": [
        "If my lock misses am I out?"
      ],
      "checks": {
        "tools": [
          "chance|needs|scenarios"
        ],
        "mustNot": [
          "^Yes, if your lock misses"
        ]
      },
      "regression": true,
      "note": "Nov 21: answered a what-if as if Jake were alive while he was already out"
    },
    {
      "source": "seed",
      "id": "needs",
      "screen": "pickem",
      "turns": [
        "What do I need to win?"
      ],
      "checks": {
        "tools": [
          "needs|scenarios"
        ]
      },
      "note": "scenarios answers this well too (Nov 21 run)"
    },
    {
